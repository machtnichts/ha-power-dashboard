[Unit]
Description=Garage PV (Deye SUN-M160G4) -> Home Assistant via MQTT (Rust)
Documentation=file:///home/adermake/HA-POWER-DASHBOARD/deye-pv-rs/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# logs/se_vs_garage.csv is relative to this, so keep it identical to the Python unit
WorkingDirectory=/home/adermake/HA-POWER-DASHBOARD
ExecStart=/home/adermake/HA-POWER-DASHBOARD/deye-pv-rs/bin/deyepv
Restart=always
RestartSec=15
# the poller only reads the logger and publishes via HA's REST API
NoNewPrivileges=true
PrivateTmp=true

# NOTE: do not enable this while powerdash-deye-pv.service runs. The SolarMAN
# logger accepts one session at a time - two pollers means timeouts for both.
# The token is read from ~/.hermes/.env at runtime, never from this file.

[Install]
WantedBy=default.target
